# --- Required for live data (leave blank to run in demo mode) ---
NEWSAPI_KEY=

# Contact sent with Wikipedia, museum and SEC requests. Defaults to the project GitHub page, but the
# SEC asks for an email address here (e.g. CONTACT=you@example.com) and may refuse requests without one.
CONTACT=

# Optional, free: Harvard Art Museums API key (https://harvardartmuseums.org/collections/api)
HARVARD_API_KEY=

# Forbes real-time billionaires via the community rtb-api (free, no key; github.com/komed3/rtb-api).
# Figures are Forbes's, updated about monthly; fine for the prototype, licence Forbes for production.
RTB_ENABLED=true
# RTB_BASE=https://raw.githubusercontent.com/komed3/rtb-api/main/api

# SEC EDGAR (free, no key): Form 4 insider stock sales of at least EDGAR_MIN_SALE_USD become buy signals.
EDGAR_ENABLED=true
EDGAR_INTERVAL_MINUTES=10
EDGAR_MIN_SALE_USD=5000000
# Days of past filings to read on first start (weekdays only; each day is read once).
EDGAR_BACKFILL_DAYS=3

# --- Optional, paid: AI classification and research briefs. Ignored while FREE_APIS_ONLY=true
ANTHROPIC_API_KEY=
# Free sources only (NewsAPI free plan, Wikipedia/Wikidata, Met and Cleveland museum APIs).
FREE_APIS_ONLY=true

# How often to pull, in minutes. 30 => 48 requests/day.
PULL_INTERVAL_MINUTES=30
# Hard ceiling on NewsAPI requests in any rolling 24h window (free plan = 100).
DAILY_REQUEST_LIMIT=95

# What each pull asks NewsAPI for:
#   top        -> /v2/top-headlines (US, all categories)
#   everything -> /v2/everything with the wealth-event query below
#   alternate  -> switch between the two on every pull (recommended)
PULL_MODE=alternate
NEWSAPI_COUNTRY=us

# On startup, catch up on the last 7 full days of wealth stories: one request per day, and only
# for days not already fully loaded (so a restart usually costs 0-1 requests).
BACKFILL_ON_START=true
BACKFILL_DAYS=7

PORT=5050
