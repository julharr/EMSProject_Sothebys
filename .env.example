# --- Required for live data (leave blank to run in demo mode) ---
NEWSAPI_KEY=

# --- Optional: enables AI classification + people extraction (much better than keyword rules) ---
ANTHROPIC_API_KEY=

# How often to pull, in minutes. 30 => 48 requests/day.
PULL_INTERVAL_MINUTES=30
# Hard ceiling on NewsAPI requests in any rolling 24h window (free plan = 100).
DAILY_REQUEST_LIMIT=95

# What each pull asks NewsAPI for:
#   top        -> /v2/top-headlines (US, all categories)
#   everything -> /v2/everything with the wealth-event query below
#   alternate  -> switch between the two on every pull (recommended)
PULL_MODE=alternate
NEWSAPI_COUNTRY=us

# On startup, catch up on the last 7 full days of wealth stories: one request per day, and only
# for days not already fully loaded (so a restart usually costs 0-1 requests).
BACKFILL_ON_START=true
BACKFILL_DAYS=7

PORT=5050
